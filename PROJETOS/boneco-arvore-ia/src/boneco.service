# Inicia o boneco sozinho quando o Raspberry liga (instalado pelo instalar.sh)
[Unit]
Description=Boneco Arvore IA
After=sound.target ollama.service
Wants=ollama.service

[Service]
User=__USUARIO__
WorkingDirectory=__PASTA__
ExecStartPre=/bin/sleep 10
ExecStart=__PASTA__/.venv/bin/python boneco.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
