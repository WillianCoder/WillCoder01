# 📄 O QUE É: modelo das CONFIGURAÇÕES SECRETAS. Copie para um arquivo chamado .env e preencha.
# ✏️ EDITÁVEL: todos os valores depois do "=".
# ⚠️ CUIDADO: o arquivo .env NUNCA vai para o GitHub (já está bloqueado no .gitignore).

DATABASE_URL=postgresql://bizu:bizu@localhost:5432/bizu
APP_NAME=Bizu do Salles
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# 1 = usar o checkout de teste (sandbox) do Mercado Pago
MERCADOPAGO_SANDBOX=
ANTHROPIC_API_KEY=
# Endereço público do site (usado nos links enviados por e-mail)
APP_URL=http://localhost:3000
# E-mail (opcional): crie a chave em resend.com. Sem ela, gere links de senha no painel.
RESEND_API_KEY=
EMAIL_FROM=
