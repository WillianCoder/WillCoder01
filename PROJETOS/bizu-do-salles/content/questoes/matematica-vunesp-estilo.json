  "questions": [
    {
      "code": "MAT-RAC-001",
      "difficulty": "EASY",
      "statement": "Uma equipe percorreu 3/5 de um trajeto de 40 km. Quantos quilômetros faltam?",
      "options": {
        "A": "12 km",
        "B": "16 km",
        "C": "20 km",
        "D": "24 km",
        "E": "28 km"
      },
      "correct": "B",
      "explanation": "Percorrido: 3/5 × 40 = 24 km. Faltam 40 − 24 = 16 km.",
      "reference": "Frações"
    },
    {
      "code": "MAT-RAC-002",
      "difficulty": "EASY",
      "statement": "Um batalhão tem 250 policiais, e 12% estão de férias. Quantos estão de férias?",
      "options": {
        "A": "12",
        "B": "25",
        "C": "30",
        "D": "35",
        "E": "50"
      },
      "correct": "C",
      "explanation": "12% de 250 = 0,12 × 250 = 30.",
      "reference": "Porcentagem"
    },
    {
      "code": "MAT-RAC-003",
      "difficulty": "MEDIUM",
      "statement": "Um produto custava R$ 80,00 e passou a custar R$ 92,00. O aumento foi de:",
      "options": {
        "A": "10%",
        "B": "12%",
        "C": "15%",
        "D": "18%",
        "E": "20%"
      },
      "correct": "C",
      "explanation": "Aumento: 92 − 80 = 12. 12 ÷ 80 = 0,15 = 15%.",
      "reference": "Porcentagem: variação percentual"
    },
    {
      "code": "MAT-RAC-004",
      "difficulty": "MEDIUM",
      "statement": "Três viaturas fazem uma ronda em 6 horas. Mantido o ritmo, quantas horas levariam 2 viaturas para a mesma ronda?",
      "options": {
        "A": "4 horas",
        "B": "6 horas",
        "C": "8 horas",
        "D": "9 horas",
        "E": "12 horas"
      },
      "correct": "D",
      "explanation": "Grandezas inversamente proporcionais: 3 × 6 = 2 × x → x = 9 horas.",
      "reference": "Regra de três simples inversa"
    },
    {
      "code": "MAT-RAC-005",
      "difficulty": "EASY",
      "statement": "Um carro consome 8 litros a cada 100 km. Quantos litros consome em 350 km?",
      "options": {
        "A": "24 litros",
        "B": "26 litros",
        "C": "28 litros",
        "D": "30 litros",
        "E": "32 litros"
      },
      "correct": "C",
      "explanation": "Regra de três direta: 8/100 = x/350 → x = 28 litros.",
      "reference": "Regra de três simples direta"
    },
    {
      "code": "MAT-RAC-006",
      "difficulty": "MEDIUM",
      "statement": "Dois turnos se repetem a cada 6 dias e a cada 8 dias. Se coincidiram hoje, voltarão a coincidir em:",
      "options": {
        "A": "14 dias",
        "B": "16 dias",
        "C": "24 dias",
        "D": "32 dias",
        "E": "48 dias"
      },
      "correct": "C",
      "explanation": "Múltiplos de 6: 6, 12, 18, 24... Múltiplos de 8: 8, 16, 24... O primeiro comum é o MMC(6, 8) = 24.",
      "reference": "Mínimo múltiplo comum"
    },
    {
      "code": "MAT-RAC-007",
      "difficulty": "EASY",
      "statement": "As notas de um aluno foram 6, 7, 8 e 9. A média aritmética simples é:",
      "options": {
        "A": "7",
        "B": "7,25",
        "C": "7,5",
        "D": "8",
        "E": "8,5"
      },
      "correct": "C",
      "explanation": "(6 + 7 + 8 + 9) ÷ 4 = 30 ÷ 4 = 7,5.",
      "reference": "Média aritmética simples"
    },
    {
      "code": "MAT-RAC-008",
      "difficulty": "MEDIUM",
      "statement": "Resolva: 3x − 7 = 2x + 5.",
      "options": {
        "A": "x = 12",
        "B": "x = −2",
        "C": "x = 2",
        "D": "x = 6",
        "E": "x = 15"
      },
      "correct": "A",
      "explanation": "3x − 2x = 5 + 7 → x = 12.",
      "reference": "Equação do 1º grau"
    },
    {
      "code": "MAT-RAC-009",
      "difficulty": "MEDIUM",
      "statement": "A soma de dois números é 50 e a diferença entre eles é 14. O maior número é:",
      "options": {
        "A": "18",
        "B": "28",
        "C": "30",
        "D": "32",
        "E": "36"
      },
      "correct": "D",
      "explanation": "x + y = 50 e x − y = 14 → 2x = 64 → x = 32 (e y = 18).",
      "reference": "Sistema de equações do 1º grau"
    },
    {
