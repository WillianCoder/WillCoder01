{
  "name": "bizu-do-salles",
  "version": "0.8.0",
  "description": "Bizu do Salles — plataforma de estudos por questões (Ciclo Básico + Específico).",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "prisma generate && tsc --noEmit",
    "validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "content:report": "tsx scripts/content-report.ts",
    "db:backup": "bash scripts/backup.sh",
    "db:restore": "bash scripts/restore.sh",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "admin:create": "tsx scripts/create-admin.ts",
    "db:deploy": "prisma migrate deploy",
    "test:e2e": "playwright test",
    "relatorio": "node scripts/gerar-relatorio.mjs",
    "postinstall": "prisma generate",
    "comandos": "node scripts/gerar-comandos.mjs",
    "aprendizado": "node scripts/gerar-aprendizado.mjs"
  },
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^6.19.3",
    "next": "^15.5.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "private": true,
  "overrides": {
    "postcss": "^8.5.28",
    "deepmerge-ts": "^8.0.0"
  }
}
